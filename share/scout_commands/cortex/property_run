#!/usr/bin/env ruby
# frozen_string_literal: true

# scout cortex property_run -- Run a property for one entity or a named list; returns the run receipt (design 2.3/2.7)

require 'scout'

require_relative '../../../lib/Cortex/cli'

$0 = "scout #{$previous_commands.any? ? "#{$previous_commands * ' '} " : ''}#{File.basename(__FILE__)}" if $previous_commands
cmd = $0

options = SOPT.setup <<~EOF

  Run a property for one entity or a named list; returns the run receipt (design 2.3/2.7)

  $ #{cmd} [<options>] <entity_type> <property>

  -h--help Print this help
  -et--entity_type* Entity type (Ruby constant path, e.g. Gene)
  -p--property* Property name
  -e--entity* Entity id (single receiver; never together with list). An inline JSON array is accepted and fans out
  -l--list* Named list <entity_type>/<list> (never together with entity)
  -a--arguments* Property arguments (JSON object, never positional)
  -en--entity_options* Entity annotation options (JSON object)
  -u--update Clean the property job(s) and recompute
  -t--timeout* Execution timeout in seconds; omit to use the configured default (config key timeout, tokens entity_property/cortex; env CORTEX_ENTITY_PROPERTY_TIMEOUT; default 3600). 0/false/none = unbounded
  -ag--agent* Agent name recorded in provenance
EOF
if options[:help]
  if defined? scout_usage
    scout_usage
  else
    puts SOPT.doc
  end
  exit 0
end

entity_type, property = IndiferentHash.process_options options, :entity_type, :property

entity_type = ARGV.shift if entity_type.nil?
property = ARGV.shift if property.nil?

raise MissingParameterException, :entity_type if entity_type.nil?
raise MissingParameterException, :property if property.nil?

options[:entity_type] = entity_type
options[:property] = property

raise ParameterException, "Extra positional arguments: #{ARGV * ' '}" unless ARGV.empty?

Cortex::CLI.dispatch 'cortex_property_run', options
