Cortex=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
	README.md
 start_chat
 workflow.rb
 chats=chats filter="*"{
  briefs

  observation

  cortex

  timeout

  arguments
 }
 lib=lib {
  Cortex=Cortex{
   activity.rb
   activity=activity{
    context.rb
    investigations_facet.rb
    lists_facet.rb
    mentions_facet.rb
    properties_facet.rb
   }
   artifacts.rb
   briefs.rb
   cli.rb
   conversations.rb
   entities.rb
   evidence.rb
   helpers.rb
   listing.rb
   lists.rb
   path_maps.rb
   properties.rb
   properties_run.rb
   receipt.rb
   storage.rb
   types.rb
   tasks=tasks{
    activity.rb
    artifact.rb
    conversation.rb
    entity.rb
    list.rb
    listing.rb
   }
  }
 }
 share=share filter="*"{
 }
 data=data filter="*"{
 }
 test=test {
  test_helper.rb
 }
 share=share{
 scout_commands=scout_commands{
  cortex
 }
}
}
