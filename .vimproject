Cortex=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
 workflow.rb
 chats=chats filter="*"{
  EvolveCortex.md
  continue
  develop
  entities
  fit_agent
  lib_path_map
  test
  test.analysis
 }
 lib=lib {
  Cortex=Cortex{
   entities.rb
   tasks=tasks{
    entity.rb
   }
  }
 }
 share=share filter="*"{
 }
 data=data filter="*"{
 }
 test=test {
  test_helper.rb
 }
}
