Cortex=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
	README.md
 start_chat
 workflow.rb
 chats=chats filter="*"{
  EvolveCortex.md
  briefs
  continue
  cortex
  develop
  entities
  fit_agent
  history
  history.analysis
  inheritance
  inheritance_test
  lib_path_map
  lib_path_map.analysis
  observation
  path_map
  test
  test.analysis
  timeout
 }
 lib=lib {
  Cortex=Cortex{
   artifacts.rb
   briefs.rb
   conversations.rb
   entities.rb
   helpers.rb
   listing.rb
   lists.rb
   path_maps.rb
   storage.rb
   activity.rb
   activity=activity{
    context.rb
    investigations_facet.rb
    lists_facet.rb
    mentions_facet.rb
    properties_facet.rb
   }
   tasks=tasks{
    activity.rb
    artifact.rb
    conversation.rb
    entity.rb
    list.rb
    listing.rb
   }
  }
 }
 share=share filter="*"{
 }
 data=data filter="*"{
 }
 test=test {
  test_helper.rb
 }
 share=share{
 scout_commands=scout_commands{
  cortex
 }
}
}
