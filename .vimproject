Cortex=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
	README.md
 workflow.rb
 chats=chats filter="*"{
  EvolveCortex.md
  continue
  develop
  entities
  fit_agent
  lib_path_map
  test
  test.analysis
 }
 lib=lib {
  Cortex=Cortex{
   artifacts.rb
   briefs.rb
   conversations.rb
   entities.rb
   helpers.rb
   listing.rb
   lists.rb
   path_maps.rb
   storage.rb
   tasks=tasks{
    artifact.rb
    conversation.rb
    entity.rb
    list.rb
    listing.rb
   }
  }
 }
 share=share filter="*"{
 }
 data=data filter="*"{
 }
 test=test {
  test_helper.rb
 }
}
